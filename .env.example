# Copy to .env.local. Local values come from `npx supabase status` (after `npx supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth for the local Supabase stack (Google Cloud console → OAuth client, redirect URI
# http://127.0.0.1:54321/auth/v1/callback). Read by supabase/config.toml. Never commit real values.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# local dev only: shows an email/password login on /login (never set this in production)
NEXT_PUBLIC_DEV_LOGIN=
